---
// Port fidel de plantilles/index-codiHome.php (temaLaPera)
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const UP = "/wp-content/uploads/2024/10";
---

<Layout>
  <Header />

  <!-- Hero -->
  <section id="lpl-hero">
    <div class="lpl-hero-cont-textos">
      <h1>
        Experts en gestió web per a WordPress i ecommerce. Creació, manteniment
        i seguretat per a la teva plataforma web.
      </h1>
      <h2>
        Som els Doctors del WordPress.<br />
        Si tens problemes o no t'en surts, nosaltres t'ajudem i els solucionem.
      </h2>
      <h2>
        Actualitzacions, millora, optimització i posada a punt de la teva web
        WordPress o botiga online, basada en WooCommerce, Easy Digital
        Downloads, Prestashop i Shopify.
      </h2>
    </div>
    <div class="lpl-hero-cont-logos">
      <div id="lpl-hero-logos">
        <div class="lpl-cont-logosMarques">
          <img
            src={`${UP}/Wordpress-logo.svg`}
            alt="Logotip Wordpress vector"
          />
          <h6>El CMS més popular</h6>
          <p>
            Instal·lat al 45% de totes les webs d'internet, i en plena expansió.
          </p>
        </div>
        <div class="lpl-cont-logosMarques">
          <img src={`${UP}/Woo-logo.svg`} alt="Logotip WooCommerce vector" />
          <h6>La botiga a Wordpress</h6>
          <p>La millor solució ecommerce per a la plataforma WordPress.</p>
        </div>
        <div class="lpl-cont-logosMarques">
          <img
            src={`${UP}/Prestashop-logo.svg`}
            alt="Logotip Prestashop vector"
          />
          <h6>Ecommerce Prestashop</h6>
          <p>
            El creador independent de botigues online més utilitzat a Europa.
          </p>
        </div>
        <div class="lpl-cont-logosMarques">
          <img src={`${UP}/Shopify-logo.svg`} alt="Logotip Shopify vector" />
          <h6>Gestor de botiga al nuvol</h6>
          <p>
            Plataforma Saas amb més de 2 milions de comerços generats al mon.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Qui Som -->
  <section id="lpl-quiSom">
    <div class="lpl-quiSom-cont">
      <div class="lpl-quiSom-colEsquerra">
        <img
          src={`${UP}/macboo-y-peras-sobre-mesa-compo-800H.webp`}
          alt="La Pera sobre teclado Macbook abierto i dos peres naturals al costat"
        />
      </div>
      <div class="lpl-quiSom-colDreta">
        <h3>Som La Pera Llimonera, ok, però qui som?</h3>
        <p>
          Som una empresa de solucions informàtiques i gestió web per a
          WordPress i ecommerce, a les comarques de Lleida i ponent. Acabem de
          aterrar a un poblet de La Segarra, molt a prop de Guissona. Venim de
          Barcelona, on hem estat durant uns bons anys treballant amb empreses
          de la capi.
        </p>
        <p>
          A Barna vam començar com a agència de publicitat fa uns quants anys i
          hem evolucionat cap a la programació web on, sobretot, ens divertim
          amb el WordPress i la programació. Hem treballat per a empreses tant
          grans com l'Ikea Badalona, o assistint amb coneixements i donant
          formació a la cadena de botigues d'Apple K-tuin Barcelona.
        </p>
        <p>
          Ara, li donem un nou accent a la nostra vida, el caracteristic accent
          de les terres de ponent, però sense perdre el nostre caràcter
          barceloní tan natural. Aportem la nostra experiència i "savoir faire"
          a aquestes magnífiques terres, les terres de la pera més deliciosa del
          mon, la pera llimonera de Lleida!
        </p>
        <p>
          Ah, i per cert, encara que no ho sembli per tot lo que aquesta web
          transmet, som persones serioses.
        </p>
      </div>
    </div>
  </section>

  <!-- Hospital -->
  <section id="lpl-hospital">
    <div id="lpl-hospital-cont">
      <header id="lpl-hospi-cont-textes">
        <h3>Recuperació, manteniment i ajuda per a WordPress i ecommerce</h3>
        <div id="lpl-hospital-codi">
          <div class="lpl-qF-H-Cont-cols">
            <div class="lpl-qf-H-cols">
              <div class="lpl-qf-H-cols-icon"></div>
              <h4>Recuperació completa i exitosa de la teva web</h4>
            </div>
            <div class="lpl-qf-H-cols">
              <div class="lpl-qf-H-cols-icon"></div>
              <h4>Actualització de temes i complements</h4>
            </div>
            <div class="lpl-qf-H-cols">
              <div class="lpl-qf-H-cols-icon"></div>
              <h4>Millora de la velocitat de càrrega de codi i imatges</h4>
            </div>
            <div class="lpl-qf-H-cols">
              <div class="lpl-qf-H-cols-icon"></div>
              <h4>Reparació d'enllaços trencats o caducats</h4>
            </div>
          </div>
        </div>
      </header>
      <div id="lpl-hospi-enfermera">
        <img
          src={`${UP}/Metge.svg`}
          alt="metge La Pera vector repara web wordpress"
        />
      </div>
    </div>
  </section>

  <!-- Seguretat -->
  <section id="lpl-seguretat">
    <div class="lpl-seguretat-cont">
      <header id="lpl-seguretat-textes">
        <h3>Protecció, seguretat i vigilancia activa</h3>
        <section id="lpl-cont-seguretat">
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>
              Protecció contra malware, intents d'atacs de força bruta i
              violacio de dades
            </h4>
          </div>
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>
              Gestió i renovació continua de contrassenyes úniques d'alta
              seguretat
            </h4>
          </div>
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>
              Firewall de servidor i complements de seguretat activa i passiva
            </h4>
          </div>
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>Autenticació de doble factor per a comptes d'usuaris</h4>
          </div>
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>Monitoreig i vigilancia en temps real de web i servidor</h4>
          </div>
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>Auditories per a trovar vulnerabilitats a explotar</h4>
          </div>
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>Copies de seguretat de doble factor en local i servidor</h4>
          </div>
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>
              Sistema infalible de backups que garantitza tot el contingut del
              client
            </h4>
          </div>
          <div class="lpl-S-capsules">
            <div class="lpl-S-cap-icona"></div>
            <h4>
              Recuperació ràpida que minimitza la inactivitat de la plataforma
            </h4>
          </div>
        </section>
      </header>
      <div id="lpl-personatges-lladre-i-poli">
        <div class="lpl-seguretat-caps-pers">
          <img
            src={`${UP}/Lladregot.svg`}
            alt="La pera llimonera Pera lladre hacker"
          />
        </div>
        <div class="lpl-seguretat-caps-pers">
          <img
            src={`${UP}/Polisman.svg`}
            alt="La pera llimonera Pera policia"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Redacció i SEO -->
  <section id="lpl-teatre">
    <div class="lpl-teatre-cont">
      <header id="lpl-teatre-C-textos">
        <h3>Redacció, continguts originals, i posicionament web SEO</h3>
        <div class="lpl-teatre-textes">
          <p>
            Creem idees per a posicionar millor el teu producte a Internet. <br
            /><br />
            Amb aquest objectiu en ment, imaginem continguts originals i els redactem,
            com si fossim la Mercé Rodoreda o el nostre estimat amic segarrenc Manuel
            de Pedrolo. <br /><br />
            Pensem històries que puguin atreure la atenció de visitants i webs amb
            millor ranking i autoritat, que ens ajudi a creixer.
          </p>
          <p>
            I com escriuria el mateix Shakespeare: "SEO o no SEO, aquesta és la
            qüestió" (o quelcom semblant...). <br /><br />
            Perqué avui si no plantegem la web o botiga com un producte orientat al
            posicionament orgànic, ningú ens trobarà. <br /><br />
            Per aixó, pensem títols, subtítols, frases i paraules claus per treure
            la millor puntuació a l'algoritme de Google.
          </p>
        </div>
      </header>
      <div id="lpl-personatges-shakespeare">
        <div class="lpl-teatre-sentence">
          <em
            ><span>"</span>SEO o no SEO, aquesta és la qüestió!<span>"</span
            ></em
          >
        </div>
        <div class="lpl-teatre-personatge">
          <img
            src={`${UP}/Shakespeare.svg`}
            alt="La Pera ShakesPera redacció i literatura SEO"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Fem facil -->
  <section id="lpl-femFacil">
    <div id="lpl-femFacil-cont">
      <header class="lpl-femFacil-textes">
        <h3>T'ho fem fàcil</h3>
        <h4>
          Autònoms i empreses ja tenen prou amb la gestió del seu propi negoci
          com per afegir-hi els problemes que genera la seva plataforma web. Per
          això, volem ajudar-vos amb les coses que generen mals de cap i
          càrregues de temps.
        </h4>
        <h4>
          Coneix l'estat de la teva web i resol els primers dubtes de manera
          gratuïta. Contacta amb nosaltres.
        </h4>
      </header>
      <div id="lpl-cont-files-caselles">
        <div class="lpl-cont-caselles">
          <div class="lpl-casella lpl-imatges-peres-startEnd">
            <img src={`${UP}/pera-movil-1.webp`} alt="" />
          </div>
          <div id="lpl-casella-text-1" class="lpl-casella">
            <div class="lpl-queFem-vectors"></div>
            <div class="lpl-casella-cont-text">
              <div class="lpl-queFem-sombraVectors"></div>
              <p>
                Posicionament orgànic (SEO) i de pagament (SEM), per a Google,
                Bing, i altres buscadors.
              </p>
            </div>
          </div>
          <div id="lpl-casella-text-2" class="lpl-casella">
            <div class="lpl-queFem-vectors"></div>
            <div class="lpl-casella-cont-text">
              <div class="lpl-queFem-sombraVectors"></div>
              <p>
                Marketing de continguts per fer creixer la presencia de la teva
                web a internet.
              </p>
            </div>
          </div>
          <div class="lpl-casella-buida"></div>
        </div>
        <div class="lpl-cont-caselles">
          <div class="lpl-casella-buida"></div>
          <div id="lpl-casella-text-3" class="lpl-casella">
            <div class="lpl-queFem-vectors"></div>
            <div class="lpl-casella-cont-text">
              <div class="lpl-queFem-sombraVectors"></div>
              <p>
                Anàlisi de dades de les visites i comportament a de la teva web.
                Qui entra, qué fa, d'on ve?
              </p>
            </div>
          </div>
          <div id="lpl-casella-text-4" class="lpl-casella">
            <div class="lpl-queFem-vectors"></div>
            <div class="lpl-casella-cont-text">
              <div class="lpl-queFem-sombraVectors"></div>
              <p>
                Optimització tecnològica del pes i velocitat de la teva web,
                mitjançant nous formats gràfics i millorant codi intern.
              </p>
            </div>
          </div>
          <div class="lpl-casella lpl-imatges-peres-startEnd">
            <div id="lpl-que-fem-vector-final" class="lpl-queFem-vectors"></div>
            <img src={`${UP}/pera-movil-2.webp`} alt="Pera movil final" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Qué diuen -->
  <section id="lpl-queDiuen">
    <header class="lpl-qDiuen-capsulasIntro">
      <h3>Solucions informàtiques q son La Pera Llimonera!</h3>
      <div class="lpl-qDiuen-contCaps">
        <div class="lpl-qDiuen-capsules">
          <div id="lpl-qDiuen-peres-ulleres" class="lpl-qDiuen-caps-imagen">
            <img src={`${UP}/laPera-Assessoria.webp`} alt="" />
            <svg
              id="Capa_2"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 83.25 39.06"
            >
              <g
                ><circle class="cls-1" cx="41.71" cy="23.23" r="14.73"
                ></circle><circle class="cls-2" cx="68.83" cy="14.42" r="13.41"
                ></circle><line
                  class="cls-1"
                  x1="27.56"
                  y1="26.8"
                  x2="1.1"
                  y2="28.42"></line></g
              >
            </svg>
          </div>
          <p>
            T'assesorem tecnològicament per empendre de la millor manera el teu
            negoci a internet.
          </p>
        </div>
        <div class="lpl-qDiuen-capsules">
          <div id="lpl-qDiuen-peres-clau" class="lpl-qDiuen-caps-imagen">
            <svg
              id="Capa_2"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 35.51 43.66"
            >
              <g
                ><circle class="cls-1" cx="10.49" cy="33.17" r="9.53"
                ></circle><line
                  class="cls-1"
                  x1="16.8"
                  y1="25.94"
                  x2="34.54"
                  y2="8.19"></line><line
                  class="cls-1"
                  x1="34.54"
                  y1="8.19"
                  x2="27.31"
                  y2=".96"></line><line
                  class="cls-1"
                  x1="26.66"
                  y1="16.08"
                  x2="21.24"
                  y2="10.66"></line></g
              >
            </svg>
            <img src={`${UP}/laPera-allotjament.webp`} alt="" />
          </div>
          <p>
            Donem allotjament de gran seguretat i amb les últimes tecnologíes.
          </p>
        </div>
        <div class="lpl-qDiuen-capsules">
          <div id="lpl-qDiuen-peres-cordill" class="lpl-qDiuen-caps-imagen">
            <svg
              id="Capa_2"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 6.25 86.86"
            >
              <g
                ><line class="cls-2" x1="2.73" y1="32.24" x2="5.2" y2="83.5"
                ></line><line
                  class="cls-2"
                  x1="3.13"
                  y1="14.76"
                  x2="1.04"
                  y2="85.82"></line><circle
                  class="cls-1"
                  cx="3.21"
                  cy="1.42"
                  r="1.42"></circle><circle
                  class="cls-1"
                  cx="3.12"
                  cy="5.87"
                  r="1.42"></circle><circle
                  class="cls-1"
                  cx="3.08"
                  cy="10.61"
                  r="1.42"></circle></g
              >
            </svg>
            <img src={`${UP}/laPera-formacio.webp`} alt="" />
          </div>
          <p>
            Et formem per que puguis fer creixer el teu Wordpress i et tornis
            independent.
          </p>
        </div>
        <div class="lpl-qDiuen-capsules">
          <div id="lpl-qDiuen-peres-bombeta" class="lpl-qDiuen-caps-imagen">
            <svg
              id="Capa_2"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 59.72 59.72"
            >
              <g
                ><path
                  class="cls-1"
                  d="m42.05,17.42c-3.23-3.23-7.71-4.98-12.44-4.98-9.21.25-16.92,7.71-17.17,17.17,0,5.47,2.24,10.45,6.72,13.93,1.99,1.74,3.23,3.98,3.23,6.47v5.23c0,2.99,1.99,4.48,3.73,4.48h7.47c1.99,0,3.73-1.74,3.73-3.73v-5.72c0-2.49,1.24-5.23,3.48-6.97,4.23-3.23,6.47-8.21,6.47-13.44,0-4.73-1.99-9.21-5.23-12.44Zm-8.46,39.81h-7.47c-1.24,0-1.24-1.49-1.24-1.99v-2.99h9.95v3.73c0,.75-.5,1.24-1.24,1.24Zm5.72-15.93c-2.6,2.13-4.3,5.37-4.46,8.46h-9.97c-.07-3.14-1.56-6.03-4.23-8.21-3.73-2.74-5.72-7.22-5.72-11.94.25-7.96,6.97-14.68,14.93-14.68,3.98,0,7.71,1.49,10.45,4.23,2.99,2.99,4.48,6.72,4.48,10.7,0,4.48-1.99,8.71-5.47,11.45Z"
                ></path></g
              >
            </svg>
            <img src={`${UP}/laPera-idees.webp`} alt="" />
          </div>
          <p>
            Tirem endevant i donem forma als teus projectes i idees dintre de
            les xarxes.
          </p>
        </div>
      </div>
    </header>
    <main class="lpl-qDiuen-natrus">
      <h3>Qué diuen de nosaltres</h3>
      <p>
        Petit recull, aixi desenfadat, de les coses bones que diuen de nosaltres
        els nostres clients i amics.
      </p>
      <div class="lpl-qDiuen-N-contBocates">
        <div class="lpl-qDiuen-N-bocata" id="lpl-qDiuen-bocata-Midas">
          <h4>El Dani, de MidasGestion, diu...</h4>
          <p>
            "El servicio que ofrecéis es muy difícil de encontrar. Siempre
            estáis ahí cuando os he necesitado, En los peores y los mejores
            momentos."
          </p>
          <div class="lpl-qDiuen-N-b-contLogo">
            <a href="https://midasgestion.es" target="_blank" rel="noopener"
              ><img
                src={`${UP}/lpl-logo-Midas.svg`}
                alt="Logo MidasGestion"
              /></a
            >
          </div>
        </div>
        <div class="lpl-qDiuen-N-bocata" id="lpl-qDiuen-bocata-Phoenix">
          <h4>La Dolors, de Phoenix Arts Europe, explica...</h4>
          <p>
            "Ens agrada treballar amb vosaltres perque ens aporteu la segona
            opinió que necessitem, i que sol ser la bona, la de la experiència"
          </p>
          <div class="lpl-qDiuen-N-b-contLogo">
            <a href="https://phoenixarts.eu" target="_blank" rel="noopener"
              ><img
                src={`${UP}/lpl-Logo-Phoenix.svg`}
                alt="Logo Phoenix Arts Europe"
              /></a
            >
          </div>
        </div>
      </div>
      <div class="lpl-qDiuen-N-imatgePera">
        <img
          src={`${UP}/pera-cistell-qDiuen-900W.webp`}
          alt="Cistell de peres"
        />
      </div>
      <section class="lpl-qDiuen-N-contBocates">
        <div class="lpl-qDiuen-N-bocata" id="lpl-qDiuen-bocata-Amorino">
          <h4>La Judith, d'Amorino España, comenta...</h4>
          <p>
            "Siempre acabo recurriendo a vosotros, porque me solucionáis el
            problema de forma rápida, eficaz y muy ajustado a lo que quiero."
          </p>
          <div class="lpl-qDiuen-N-b-contLogo">
            <a href="https://amorino.com" target="_blank" rel="noopener"
              ><span class="lpl-logo-text">Amorino</span></a
            >
          </div>
        </div>
        <div class="lpl-qDiuen-N-bocata" id="lpl-qDiuen-bocata-Euromed">
          <h4>La Montse, d'Euromed, afageix...</h4>
          <p>
            "Nomes fer-te saber que és tot un plaer treballar amb tu i considero
            que sou uns molt bons professionals."
          </p>
          <div class="lpl-qDiuen-N-b-contLogo">
            <a href="https://euromedgroup.com" target="_blank" rel="noopener"
              ><img src={`${UP}/lpl-logo-Euromed.svg`} alt="Logo Euromed" /></a
            >
          </div>
        </div>
      </section>
    </main>
  </section>

  <!-- Formulari -->
  <section id="lpl-formulari">
    <header>
      <h3>Contacta'ns</h3>
      <p>
        Tens cap pregunt o necessites ajuda? algú que fassi per tú la gestió web
        per a WordPress i ecommerce? omple el nostre formulari. Et contactarem
        el més aviat possible. Estem disponibles per a tot allò que necessitis.
        Gràcies per escriure'ns!.
      </p>
    </header>
    <main>
      <div id="wpcf7-f9-o1">
        <form
          class="wpcf7-form"
          name="contacte"
          method="POST"
          action="/"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          data-note="Cal connectar aquest formulari a un servei d'enviament (Formspree, Netlify Forms, backend propi, etc.)"
        >
          <div class="lpl-form-contCols">
            <p>
              <label>
                Nom*
                <input
                  type="text"
                  name="nom"
                  required
                  class="wpcf7-form-control"
                />
              </label>
            </p>
            <p>
              <label>
                Empresa/Botiga*
                <input
                  type="text"
                  name="empresa"
                  required
                  class="wpcf7-form-control"
                />
              </label>
            </p>
            <p>
              <label>
                Mail*
                <input
                  type="email"
                  name="email"
                  required
                  class="wpcf7-form-control"
                />
              </label>
            </p>
            <p>
              <label>
                Telèfon
                <input type="tel" name="telefon" class="wpcf7-form-control" />
              </label>
            </p>
            <p class="lpl-form-1col">
              <label>
                Missatge*
                <textarea
                  name="missatge"
                  rows="5"
                  required
